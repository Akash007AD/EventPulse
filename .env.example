# ==============================================================================
# EventPulse - Root Environment Configuration Template (.env.example)
# Copy to .env and fill in your secrets.
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev

# Ports
GATEWAY_PORT=8080
EVENT_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
ANALYTICS_SERVICE_PORT=8085
AI_DISCOVERY_SERVICE_PORT=8086
KEYCLOAK_PORT=8180

# Database
MYSQL_ROOT_PASSWORD=root
EVENT_DB_HOST=localhost
EVENT_DB_PORT=3306
EVENT_DB_NAME=eventpulse_event
EVENT_DB_USERNAME=root
EVENT_DB_PASSWORD=root

BOOKING_DB_NAME=eventpulse_booking
PAYMENT_DB_NAME=eventpulse_payment
NOTIFICATION_DB_NAME=eventpulse_notification
ANALYTICS_DB_NAME=eventpulse_analytics

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Email SMTP (e.g. Gmail App Password, Mailtrap, Brevo, SendGrid)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@eventpulse.com

# AI
GROQ_API_KEY=mock-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Keycloak & Google OAuth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/eventpulse
GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Messaging & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
