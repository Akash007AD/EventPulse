# ==============================================================================
# EventPulse - Environment Variables Template (.env.example)
# Copy this file to .env and adjust variables for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Common Profile
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 1. Event Service (Port 8081)
# ------------------------------------------------------------------------------
EVENT_SERVICE_PORT=8081
EVENT_DB_HOST=localhost
EVENT_DB_PORT=3306
EVENT_DB_NAME=eventpulse_event
EVENT_DB_USERNAME=root
EVENT_DB_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 2. Booking Service (Port 8082 - Milestone 2)
# ------------------------------------------------------------------------------
BOOKING_SERVICE_PORT=8082
BOOKING_DB_HOST=localhost
BOOKING_DB_PORT=3306
BOOKING_DB_NAME=eventpulse_booking
BOOKING_DB_USERNAME=root
BOOKING_DB_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 3. Payment Service (Port 8083 - Milestone 5)
# ------------------------------------------------------------------------------
PAYMENT_SERVICE_PORT=8083
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=3306
PAYMENT_DB_NAME=eventpulse_payment
PAYMENT_DB_USERNAME=root
PAYMENT_DB_PASSWORD=your_mysql_password
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------------------------------------------------------
# 4. Notification Service (Port 8084 - Milestone 6)
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=3306
NOTIFICATION_DB_NAME=eventpulse_notification
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 5. Analytics Service (Port 8085 - Milestone 6)
# ------------------------------------------------------------------------------
ANALYTICS_SERVICE_PORT=8085
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=3306
ANALYTICS_DB_NAME=eventpulse_analytics
ANALYTICS_DB_USERNAME=root
ANALYTICS_DB_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 6. AI Discovery Service (Port 8086 - Milestone 7)
# ------------------------------------------------------------------------------
AI_DISCOVERY_SERVICE_PORT=8086
AI_PROVIDER_API_KEY=your_ai_api_key_here

# ------------------------------------------------------------------------------
# 7. Gateway, Keycloak & Google Identity Brokering (Milestone 3)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
KEYCLOAK_PORT=8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/eventpulse
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/eventpulse/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password

# Google Identity Provider credentials for Keycloak "Sign in with Google"
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:8180/realms/eventpulse/broker/google/endpoint
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 8. Infrastructure (Redis, Kafka, RabbitMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
